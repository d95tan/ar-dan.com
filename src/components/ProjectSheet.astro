---
import Cover from './Cover.astro';
import { yearLabel, type Project } from '../lib/projects';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const { data, id } = project;
---

<a class="sheet" href={`/work/${id}`} data-d={data.discipline} data-i={index} style={`view-transition-name: sheet-${id}`}>
  <svg class="draw" aria-hidden="true"><rect width="100%" height="100%" pathLength="1"></rect></svg>
  <div class="pic">
    <Cover src={data.cover} alt={data.coverAlt ?? data.title} label={project.sheet} style={`view-transition-name: cover-${id}`} />
  </div>
  <div class="tblock">
    <div class="title">
      <h3>{data.title}</h3>
      <p>{data.summary}</p>
    </div>
    <div class="meta">{data.stack.slice(0, 4).map((s) => <span class="tag">{s}</span>)}</div>
    <div class="no mono">{yearLabel(project)}<b>{project.sheet}</b></div>
  </div>
</a>

<style>
  /* Every edge inside a card lands on a half cell (12px), counting the 1px borders, so a card
     is always a whole number of cells tall. Change paddings together with the borders beside them. */
  .sheet {
    container-type: inline-size;
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--panel);
    border: 1px solid var(--frame);
    border-radius: var(--radius);
    text-decoration: none;
    transition: transform 0.35s var(--ease), box-shadow 0.35s, background-color 0.5s, border-color 0.5s;
  }
  :global([data-mode='archi']) .sheet:hover {
    transform: translate(-4px, -4px);
    box-shadow: 4px 4px 0 var(--ink);
  }
  :global([data-mode='tech']) .sheet {
    overflow: hidden;
  }
  :global([data-mode='tech']) .sheet:hover {
    transform: translateY(-4px);
    box-shadow: 0 0 0 1px var(--mark), 0 18px 40px #0008;
  }
  .sheet[hidden] {
    display: none;
  }
  /* Roughly 4:3, rounded down to whole cells. */
  .pic {
    position: relative;
    height: round(down, (100cqw - 22px) * 0.75, var(--cell));
    overflow: hidden;
    margin: 11px 11px 0;
    border: 1px solid var(--line-strong);
  }
  :global([data-mode='tech']) .pic {
    height: calc(round(down, 100cqw * 0.75, var(--cell)) - 1px);
    margin: 0;
    border: 0;
    border-bottom: 1px solid var(--line-strong);
  }
  .pic :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: var(--img-filter);
    transition: filter 0.6s, transform 0.8s;
  }
  .pic::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--tint);
    mix-blend-mode: color;
    opacity: var(--tint-op);
    transition: opacity 0.6s;
    pointer-events: none;
  }
  .sheet:hover .pic :global(img),
  .sheet:focus-visible .pic :global(img) {
    filter: none;
    transform: scale(1.04);
  }
  .sheet:hover .pic::after,
  .sheet:focus-visible .pic::after {
    opacity: 0;
  }
  .draw {
    position: absolute;
    inset: -1px;
    width: calc(100% + 2px);
    height: calc(100% + 2px);
    pointer-events: none;
    overflow: visible;
    z-index: 1;
  }
  :global([data-mode='tech']) .draw {
    display: none;
  }
  .draw rect {
    fill: none;
    stroke: var(--mark);
    stroke-width: 2;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.8s ease;
  }
  .sheet:hover .draw rect,
  .sheet:focus-visible .draw rect {
    stroke-dashoffset: 0;
  }
  .tblock {
    display: grid;
    grid-template-columns: 1fr auto;
    margin-top: calc(var(--cell) / 2);
    border-top: 1px solid var(--frame);
    flex: 1;
  }
  :global([data-mode='tech']) .tblock {
    margin-top: 0;
    border-top: 0;
  }
  .tblock > div {
    padding: calc(var(--cell) / 2) calc(var(--cell) / 2) calc(var(--cell) / 2 - 1px);
  }
  .tblock > .title {
    padding-top: calc(var(--cell) / 2 - 1px);
  }
  :global([data-mode='tech']) .tblock > .title {
    padding-top: calc(var(--cell) / 2);
  }
  .title {
    grid-column: 1 / -1;
    border-bottom: 1px solid var(--line-strong);
  }
  h3 {
    font-family: var(--head-font);
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    line-height: var(--cell);
  }
  :global([data-mode='tech']) h3 {
    font-weight: 600;
    font-size: 1.1rem;
  }
  :global([data-mode='tech']) h3::before {
    content: './';
    color: var(--ink-soft);
  }
  .title p {
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .meta {
    border-right: 1px solid var(--line-strong);
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 0 6px;
  }
  .no {
    text-align: right;
    min-width: 92px;
  }
  .no b {
    display: block;
    font-family: var(--sans);
    font-size: 1.4rem;
    line-height: var(--cell);
    letter-spacing: -0.02em;
  }
  :global([data-mode='tech']) .no b {
    font-family: var(--code);
    font-size: 1rem;
    color: var(--mark);
  }
</style>
