---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CursorFx from '../components/CursorFx.astro';
import { SITE } from '../site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  sheet?: string;
}

const { title, description = SITE.description, image, sheet } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.shortName}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ?? (typeof SITE.hero.image === 'string' ? SITE.hero.image : new URL(SITE.hero.image.src, Astro.site).href);
---

<!doctype html>
<html lang="en" data-mode={SITE.defaultMode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@1,9..144,300&family=IBM+Plex+Mono:wght@400;500&family=JetBrains+Mono:wght@400;600&family=Space+Grotesk:wght@400..700&display=swap"
      rel="stylesheet"
    />
    <script is:inline define:vars={{ fallback: SITE.defaultMode }}>
      try {
        const saved = localStorage.getItem('ar-dan:mode');
        document.documentElement.dataset.mode = saved === 'archi' || saved === 'tech' ? saved : fallback;
      } catch {
        document.documentElement.dataset.mode = fallback;
      }
    </script>
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <Header sheet={sheet} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CursorFx />
    <script>
      const cell = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--cell')) || 24;
      const snap = () => {
        for (const el of document.querySelectorAll<HTMLElement>('.sec-head, [data-snap]')) {
          const current = parseFloat(el.style.getPropertyValue('--snap')) || 0;
          const top = el.getBoundingClientRect().top + scrollY - current;
          const need = (cell - (((top % cell) + cell) % cell)) % cell;
          if (Math.abs(need - current) > 0.1) el.style.setProperty('--snap', `${need}px`);
        }
      };
      let queued = false;
      new ResizeObserver(() => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          snap();
        });
      }).observe(document.body);
      snap();
    </script>
  </body>
</html>
